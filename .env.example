# Copy this file to .env and fill it in. Never commit .env or share it.

# Paynow → Settings → Integrations → create a "3rd Party / Website" integration
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# true while testing. Test payments only work with your own merchant account email below.
PAYNOW_TEST_MODE=true
PAYNOW_MERCHANT_EMAIL=you@example.com

# The public address of the site, no trailing slash
PUBLIC_URL=https://primebaking.co.zw

# development while testing; production for the live shop (the server refuses production + test mode)
NODE_ENV=development
PORT=3000
# Exact number of proxies in front of the app: 1 on Render/Railway/most hosts, 2 if you also use Cloudflare, 0 if none
TRUST_PROXY=1
